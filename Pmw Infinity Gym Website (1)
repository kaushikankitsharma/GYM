  .bento{padding:20px 18px 48px}
  .grid{grid-template-columns:1fr 1fr}
  .split{grid-template-columns:1fr;gap:40px}
  section.light,section.red{padding:64px 0}
  .cta-band{padding:64px 0}
}
@media(max-width:640px){
