.hero-copy .k::before{content:"";display:inline-block;width:34px;height:3px;background:var(--off);vertical-align:middle;margin-right:12px}
.hero-copy h1{font-size:clamp(46px,6.4vw,96px);color:var(--off);margin-top:18px}
