.btn-white{background:var(--off);color:#130101}
.btn-white:hover{background:#fff}
.btn-outline{background:transparent;color:var(--off);border:1px solid var(--off)}
.btn-outline:hover{background:var(--off);color:var(--maroon)}
.btn-red{background:var(--bright);color:#fff}
