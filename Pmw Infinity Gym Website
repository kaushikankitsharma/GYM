<style>
:root{--maroon:#130101;--darkred:#5e0202;--red:#9a0604;--bright:#d11511;--off:#fbf5f5;--pale:#cdb1ad;--grey:#646159}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--maroon);color:var(--off);font-family:'Oswald',sans-serif;line-height:1.5;overflow-x:hidden}
h1,h2,h3{font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;line-height:.92;letter-spacing:.01em}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
/* ===== HERO : photo left (clear gym), red panel right (focus) ===== */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;background:var(--maroon)}
.hero-top{position:relative;flex:1;display:grid;grid-template-columns:1fr 1fr;min-height:62svh}
.hero-photo{position:relative;overflow:hidden}
.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.85) contrast(1.08) brightness(.9);animation:slowzoom 16s ease-out forwards}
@keyframes slowzoom{from{transform:scale(1.1)}to{transform:scale(1)}}
.hero-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,rgba(154,6,4,.55));pointer-events:none}
.hero-copy{position:relative;background:linear-gradient(135deg,var(--bright) 0%,var(--red) 55%,var(--darkred) 100%);display:flex;flex-direction:column;justify-content:center;padding:70px 48px 60px}
.hero-copy::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(-55deg,transparent 0 26px,rgba(251,245,245,.05) 26px 28px);pointer-events:none}
.hero-copy>*{position:relative;z-index:2}
.hero-copy .k{font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.32em;color:var(--off);text-transform:uppercase}
.hero-copy .k::before{content:"";display:inline-block;width:34px;height:3px;background:var(--off);vertical-align:middle;margin-right:12px}
.hero-copy h1{font-size:clamp(58px,6.4vw,96px);color:var(--off);margin-top:18px}
.hero-copy h1 span{display:block}
.hero-copy .sub{margin-top:18px;font-size:17px;color:rgba(251,245,245,.92);max-width:460px;font-weight:500}
.hero-cta{margin-top:30px;display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-block;font-family:'Anton',sans-serif;font-size:16px;letter-spacing:.12em;text-transform:uppercase;padding:15px 30px;cursor:pointer;border:0;transition:background .2s,color .2s,transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn-white{background:var(--off);color:#130101}
.btn-white:hover{background:#fff}
.btn-outline{background:transparent;color:var(--off);border:1px solid var(--off)}
.btn-outline:hover{background:var(--off);color:var(--maroon)}
.btn-red{background:var(--bright);color:#fff}
.btn-red:hover{background:#ef1a15}
.proof{margin-top:26px;font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.2em;color:var(--off);text-transform:uppercase}
.proof b{color:#fff}
@media(max-width:860px){.hero-top{grid-template-columns:1fr}.hero-photo{min-height:300px}.hero-copy{padding:48px 28px}}
/* header sits over the hero, above everything */
header{position:absolute;top:0;left:0;right:0;z-index:10;display:flex;align-items:center;gap:30px;max-width:1240px;margin:0 auto;padding:20px 28px}
.logo{font-family:'Anton',sans-serif;font-size:30px;letter-spacing:.04em;line-height:.9;color:var(--off);text-shadow:0 2px 14px rgba(0,0,0,.55)}
.logo span{color:#fff}
.logo small{display:block;font-family:'Oswald',sans-serif;font-size:9px;letter-spacing:.42em;color:rgba(251,245,245,.85);font-weight:600}
nav{display:flex;gap:30px;margin-left:auto;font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.14em}
nav a{color:var(--off);padding:6px 0;border-bottom:2px solid transparent;text-shadow:0 2px 12px rgba(0,0,0,.55)}
nav a:hover{border-color:var(--off)}
@media(max-width:860px){nav{display:none}}
/* ===== BENTO ROW on red ===== */
.bento{position:relative;z-index:4;max-width:1240px;margin:0 auto;padding:26px 28px 60px;display:grid;grid-template-columns:1.15fr 1.15fr .7fr;gap:20px;align-items:stretch;background:linear-gradient(120deg,var(--maroon) 0%,var(--darkred) 55%,var(--red) 100%)}
@media(max-width:900px){.bento{grid-template-columns:1fr}}
.bcard{background:var(--off);color:#130101;padding:26px;position:relative;display:flex;flex-direction:column;min-height:210px;transition:transform .25s}
.bcard:hover{transform:translateY(-5px)}
.bcard.pale{background:#efe3e1}
.bcard .pill{position:absolute;top:16px;left:16px;z-index:2;background:#fff;border:1px solid #d8d8d8;border-radius:999px;font-family:'Oswald',sans-serif;font-size:13px;font-weight:600;padding:5px 12px;color:#130101}
.bcard h3{font-size:34px;margin-top:36px}
.bcard .sub{font-family:'Anton',sans-serif;font-size:14px;letter-spacing:.16em;color:var(--grey);margin-top:8px;text-transform:uppercase}
.bcard p.body{font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.1em;color:var(--grey);line-height:1.65;text-transform:uppercase;margin-top:10px;max-width:300px}
.bcard .pic{position:absolute;right:0;top:0;bottom:0;width:42%;object-fit:cover}
.bcard .meet{margin-top:auto;padding-top:18px;font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.14em;color:#130101;text-decoration:underline;text-underline-offset:4px}
.bcard .meet:hover{color:var(--bright)}
.bcard.has-pic h3,.bcard.has-pic .sub,.bcard.has-pic p.body{max-width:56%}
.bstat{display:flex;flex-direction:column;justify-content:center;padding:10px 6px}
.bstat b{font-family:'Anton',sans-serif;font-size:clamp(64px,6vw,92px);line-height:.9;color:var(--off)}
.bstat span{font-family:'Anton',sans-serif;font-size:16px;letter-spacing:.22em;color:var(--off);margin-top:10px;text-transform:uppercase}
/* ===== LOWER SECTIONS on off-white ===== */
section.light{background:var(--off);color:#130101;padding:90px 0}
section.light .k{font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.3em;color:var(--bright);text-transform:uppercase}
section.light h2{font-size:clamp(44px,5.5vw,72px);color:#130101;margin:12px 0 16px}
section.light .lead{color:#3d3d3d;font-size:17px;max-width:640px;font-weight:500}
.quote-big{font-size:24px;font-weight:500;max-width:720px;margin-top:34px;padding-left:22px;border-left:4px solid var(--bright);color:#130101}
.quote-big span{display:block;margin-top:10px;font-size:14px;color:var(--grey);font-weight:600}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:#d8d2d0;margin-top:46px}
@media(max-width:780px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{background:#fff;padding:28px 22px}
