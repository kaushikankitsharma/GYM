.cta-band p{color:#4a4a4a;font-size:18px;max-width:560px;margin:14px auto 28px;font-weight:500}
footer{background:var(--maroon);padding:56px 0 34px;color:rgba(251,245,245,.75);font-size:14px}
.foot{display:flex;justify-content:space-between;gap:28px;flex-wrap:wrap}
.foot a{color:var(--off);font-weight:600}
.foot a:hover{color:#fff;text-decoration:underline}
.foot h4{font-family:'Anton',sans-serif;font-size:16px;letter-spacing:.18em;color:var(--off);margin-bottom:10px;text-transform:uppercase}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}.hero-photo img{animation:none}}
</style>
</head>
